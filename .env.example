# ==========================================
# FRAG NAIJA SUPPORT API - ENVIRONMENT VARIABLES
# ==========================================

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- Security & CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Comma-separated list of allowed hostnames, or * for all
ALLOWED_HOSTS=*

# --- Database (Neon or Local Postgres) ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://support:support@localhost:5432/support

# --- Qdrant (Qdrant Cloud or Local) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=support_knowledge

# --- LLM Provider (Groq) ---
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=30.0
GROQ_MAX_RETRIES=3

# --- Embeddings & Retrieval ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RETRIEVAL_CANDIDATE_K=10
RETRIEVAL_FINAL_K=3
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Observability (Langfuse) ---
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Knowledge Management (Stage 26) ---
KNOWLEDGE_STALE_DAYS=30
KNOWLEDGE_PRIORITY_MAP=document:1,website:2,faq:3,article:4

# --- Website Crawling (Stage 26.4) ---
CRAWL_SEED_URLS=
CRAWL_ALLOWED_DOMAINS=
CRAWL_ALLOWED_PATHS=
CRAWL_MAX_PAGES=50
CRAWL_MAX_RESPONSE_BYTES=1000000
CRAWL_RESPECT_ROBOTS=true